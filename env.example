# Rename this file to .env and fill in your own keys.
# Never commit the actual .env file — only this example should be public.

# Groq API key — powers the LLM (openai/gpt-oss-120b via ChatGroq)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API key — powers the web_search tool
# Get one at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
